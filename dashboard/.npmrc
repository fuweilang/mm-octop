# 国内优先：pnpm 从腾讯云 npm 镜像拉包（内容与 registry.npmjs.org 一致，
# 完整性由 pnpm-lock.yaml 里的 integrity 校验）。
# pnpm 的 lockfile 不写 registry 主机，换源不会污染 pnpm-lock.yaml，
# 所以不需要 npm 时代的 replace-registry-host 兼容开关。
registry=https://mirrors.cloud.tencent.com/npm/
# 从 npm 迁移：源码里有若干"靠 npm 扁平提升才可用"的间接依赖
# （dayjs / unified / pdfjs-dist / @ant-design/icons）。
# hoisted 布局与 npm 一致，避免一次性改一堆 import；pnpm 仍负责解析与缓存。
node-linker=hoisted