# Git and IDE
.git
.gitignore
.idea
.vscode
*.md
!README.md

# Python dev and cache
__pycache__
*.py[cod]
*$py.class
.venv
venv
.pytest_cache
.coverage
htmlcov
.tox
.mypy_cache
.ruff_cache
dist
build
*.egg-info

# Tests (not needed in runtime image)
tests
.pre-commit-config.yaml

# Frontend: stage 1 builds dashboard in-image; exclude host dev deps and pre-built output
dashboard/node_modules
dashboard/.vite
dashboard/dist
src/octop/dashboard
!src/octop/dashboard
!src/octop/dashboard/**
node_modules
**/node_modules
**/.vite

# Example and local config (mount at runtime instead)
.env
.env.*
!.env.example

# Misc
.DS_Store
*.log
logs
agent-transcripts

# 构建上下文瘦身：桌面端产物（约 5G）、上游仓库镜像、宿主 venv 与镜像无关。
# 不加这几条时 docker 每次 build 都要先把整个上下文传给 buildkit，
# 单次构建光传输就是分钟级。
/desktop
/.git.upstream
