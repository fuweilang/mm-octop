#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

PORT="${OCTOP_PORT:-8088}"

# Free the listen port so a stale python doesn't keep serving an old version.
if command -v lsof >/dev/null 2>&1; then
  pids="$(lsof -nP -iTCP:"${PORT}" -sTCP:LISTEN -t 2>/dev/null || true)"
  if [[ -n "${pids}" ]]; then
    echo "octop: clearing listeners on :${PORT} -> ${pids}"
    # shellcheck disable=SC2086
    kill ${pids} 2>/dev/null || true
    sleep 0.4
    left="$(lsof -nP -iTCP:"${PORT}" -sTCP:LISTEN -t 2>/dev/null || true)"
    if [[ -n "${left}" ]]; then
      echo "octop: force-killing :${PORT} -> ${left}"
      # shellcheck disable=SC2086
      kill -9 ${left} 2>/dev/null || true
      sleep 0.2
    fi
  fi
fi

echo "Local:   http://localhost:${PORT}"
if [[ -n "${MAMMOTH_APP_VERSION:-}" ]]; then
  echo "Version: ${MAMMOTH_APP_VERSION}"
fi
ifconfig 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" {print "Network: http://"$2":'"${PORT}"'"}'

exec uv run octop run --host 0.0.0.0 --port "$PORT" --reload
